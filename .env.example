# API Keys - Replace with your own keys
API_KEY_ALPHAVANTAGE=alphavantage_api_key
API_KEY_FINANCIALMODELINGPREP=financialmodelingprep_api_key
API_KEY_NEWS=news_api_key
API_KEY_POLYGON=polygon_api_key

# Database settings
DATABASE_URL=sqlite:///./financial_data.db

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=financial_data
DB_USER=postgres
DB_PASSWORD=replace_with_strong_password
DB_HOST_PORT=5432
REDIS_PASSWORD=replace_with_strong_password
REDIS_HOST_PORT=6379
ENABLE_SQLITE_FALLBACK=true
DISABLE_CREWAI=false
APP_HOST_PORT=8501
API_HOST_PORT=8000
LOCAL_UID=1000
LOCAL_GID=1000
STREAMLIT_SERVER_ADDRESS=127.0.0.1
STREAMLIT_SERVER_PORT=8501

# WRDS
WRDS_USERNAME=your_wrds_username

# API Keys
OPENAI_API_KEY=optional_key
HUGGINGFACE_API_KEY=optional_key

# LLM Configuration
LLM_PROVIDER=ollama
LLM_MODEL_NAME=deepseek-r1:32b
LLM_BASE_URL=http://ollama:11434
LLM_REQUEST_TIMEOUT=120
OLLAMA_MODEL=deepseek-r1:32b

# Optional startup backfills for the integrated service (python -m main / financial_app)
STARTUP_DAILY_BACKFILL_ENABLED=false
STARTUP_DAILY_BACKFILL_UNIVERSE=sp500
STARTUP_DAILY_BACKFILL_START=1991-01-01
STARTUP_DAILY_BACKFILL_END=
STARTUP_DAILY_BACKFILL_BATCH_SIZE=25
STARTUP_HOURLY_BACKFILL_ENABLED=false
STARTUP_HOURLY_BACKFILL_UNIVERSE=sp500
STARTUP_HOURLY_BACKFILL_PERIOD=6mo
STARTUP_HOURLY_BACKFILL_END=
STARTUP_HOURLY_BACKFILL_BATCH_SIZE=25

# Optional ongoing daily universe refresh
ENABLE_DAILY_MARKET_UPDATE=false
DAILY_MARKET_UPDATE_UNIVERSE=sp500
DAILY_MARKET_UPDATE_PERIOD=7d
DAILY_MARKET_UPDATE_TIME=18:30
DAILY_MARKET_UPDATE_BATCH_SIZE=25
