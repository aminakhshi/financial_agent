# API Keys - Replace with your own keys
API_KEY_ALPHAVANTAGE=alphavantage_api_key
API_KEY_FINANCIALMODELINGPREP=financialmodelingprep_api_key
API_KEY_NEWS=news_api_key
API_KEY_POLYGON=polygon_api_key

# Database settings
DATABASE_URL=sqlite:///./financial_data.db

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=financial_data
DB_USER=postgres
DB_PASSWORD=replace_with_strong_password
DB_HOST_PORT=5432
REDIS_PASSWORD=replace_with_strong_password
REDIS_HOST_PORT=6379
ENABLE_SQLITE_FALLBACK=true
DISABLE_CREWAI=false
APP_HOST_PORT=8501
API_HOST_PORT=8000
LOCAL_UID=1000
LOCAL_GID=1000

# WRDS
WRDS_USERNAME=your_wrds_username

# API Keys
OPENAI_API_KEY=optional_key
HUGGINGFACE_API_KEY=optional_key

# Ingestion & scheduler
# Enable the in-process background scheduler when running src/main.py.
# (The dedicated financial_scheduler docker-compose service sets this itself.)
SCHEDULER_ENABLED=false
SCHEDULER_TIMEZONE=America/New_York
INGESTION_HOURLY_UNIVERSE=all
INGESTION_DAILY_UNIVERSE=all
BACKFILL_START=1991-01-01
DOWNLOAD_BATCH_SIZE=25
INTER_BATCH_DELAY_S=1.0
# Effective date recorded for the initial S&P 500 membership seed.
# Default 1991-01-01 (the daily backfill horizon): current members are assumed
# to have been members through stored history until real changes are imported.
#SP500_SEED_EFFECTIVE_FROM=1991-01-01

# LLM Configuration
LLM_PROVIDER=ollama
LLM_MODEL_NAME=deepseek-r1:32b
LLM_BASE_URL=http://ollama:11434
LLM_REQUEST_TIMEOUT=120
OLLAMA_MODEL=deepseek-r1:32b
